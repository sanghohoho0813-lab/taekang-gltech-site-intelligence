# TAEKANG SITE INTELLIGENCE — 환경변수 예시 (README 2절 참고)
# 실제 값은 Vercel 환경변수 또는 .env.local(커밋 금지)에만 넣으세요. 이 파일에는 빈 값만 둡니다.

# ── 모드 ─────────────────────────────────────────────
# 비워 두면 DEMO(영업 시연: 가상 데이터, 브라우저 저장).
# live = 실제 운영(로그인·서버 DB). 빌드할 때 반영되므로 바꾸면 재빌드·재배포.
NEXT_PUBLIC_DATA_MODE=

# ── LIVE 전용 (서버에서만 읽음 — NEXT_PUBLIC_ 접두어 금지) ──
# Supabase → Connect → Transaction pooler(포트 6543) 연결 문자열 + ?sslmode=require
# 비워 두면 내 컴퓨터에서는 내장 DB(pglite:./.data/pg)를 씀. Vercel에서는 필수.
DATABASE_URL=

# 최초 설정(회사·대표 계정 만들기) 보호 코드. Vercel 운영 배포에서는 필수.
SETUP_CODE=

# (선택) 서버 1대당 DB 연결 수, 기본 5
DB_POOL_MAX=

# ── [NEXT] 실제 AI 1개 기능 — 대표자 명시 승인 후에만 ──
# 서버 전용. 아직 이 키를 읽는 코드는 없습니다.
ANTHROPIC_API_KEY=
