{
  "name": "taekang-site-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "TAEKANG SITE INTELLIGENCE — 태강지엘텍 창호·유리 공사 현장 수익·공정관리 AX+플랫폼 시연용 MVP (DEMO)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "qa:cuesheet": "node tests/qa/cuesheet.mjs",
    "build:live": "NEXT_PUBLIC_DATA_MODE=live NEXT_DIST_DIR=.next-live next build",
    "start:live": "NEXT_PUBLIC_DATA_MODE=live NEXT_DIST_DIR=.next-live next start -p 3000",
    "dev:live": "NEXT_PUBLIC_DATA_MODE=live NEXT_DIST_DIR=.next-live next dev",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "preflight": "node scripts/preflight.mjs",
    "perf": "vitest run --config vitest.perf.config.ts",
    "vapid": "node scripts/vapid.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.6",
    "jsqr": "1.4.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "pretendard": "1.3.9",
    "qrcode-generator": "1.4.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
